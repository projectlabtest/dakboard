# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# Admin account (password is required; 12+ characters)
EVENT_BOARD_ADMIN_USERNAME=admin
EVENT_BOARD_ADMIN_PASSWORD=change-me-to-a-long-password

# Optional editor account (limited content editing). Leave empty to disable editor login.
EVENT_BOARD_EDITOR_PASSWORD=
