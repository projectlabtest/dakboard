# Copy this file to .env and fill in real values. .env is gitignored; never commit it.
# These names are read by the server on every branch, including after the Event Board rename.

# Admin account (password is required; 12+ characters)
DAKBOARD_ADMIN_USERNAME=admin
DAKBOARD_ADMIN_PASSWORD=change-me-to-a-long-password

# Optional editor account (limited content editing). Leave empty to disable editor login.
DAKBOARD_EDITOR_PASSWORD=
